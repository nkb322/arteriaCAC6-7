# Set these as SERVER-SIDE Netlify environment variables. Never put real keys in source.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Comma-separated explicitly authorized test recipients; email is disabled without this.
ARTERIA_ALLOWED_RECIPIENTS=

# Optional AI companion: server-side only. Disabled unless explicitly enabled.
ARTERIA_AI_ENABLED=false
ARTERIA_AI_PROVIDER=openai
# Select a model enabled for your own provider account; no model is assumed.
ARTERIA_AI_MODEL=
ARTERIA_AI_API_KEY=
# For provider=compatible only: trusted HTTPS API base (usually ending /v1).
ARTERIA_AI_BASE_URL=
# Exact hostnames, comma separated. No redirects, local/private literal addresses or credentials.
ARTERIA_AI_ALLOWED_HOSTS=
