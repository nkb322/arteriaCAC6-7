{
  "name": "arteria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "start": "npm run build && node scripts/serve.js --production",
    "build": "node scripts/build.js",
    "preview": "node scripts/serve.js --production",
    "pretest:release": "npm run build",
    "test:release": "node tests/release-browser.cjs",
    "pretest:profile": "npm run build",
    "test:profile": "node tests/profile-browser.cjs",
    "pretest:product": "npm run build",
    "test:product": "node tests/product-browser.cjs",
    "check:hosted": "node scripts/check-hosted.mjs",
    "pretest:complete": "npm run build",
    "test:complete": "node tests/complete-browser.cjs",
    "ai:local": "npm run build && node --env-file-if-exists=.env scripts/serve-ai.mjs",
    "ai:check": "node scripts/check-ai.mjs",
    "ai:evaluate": "node scripts/evaluate-ai.mjs",
    "pretest:ai": "npm run build",
    "test:ai": "node tests/ai-browser.cjs",
    "pretest:analysis-browser": "npm run build",
    "test:analysis-browser": "node tests/analysis-browser.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
